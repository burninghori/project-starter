# 자동 테스트 설정. tests/conftest.py 가 앱 import 전에 읽는다(커밋한다 — 비밀 값 없음).
# 테스트 DB(app_test)는 tests/plugins/db_lifecycle.py 가 세션마다 새로 만들고 마이그레이션을 적용한다.
# DB 를 만들고 지워야 해서 postgres 계정으로 붙는다.

APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8001
APP_RELOAD=false
LOG_LEVEL=DEBUG

DB_HOST=127.0.0.1
DB_PORT=55434
DB_NAME=app_test
DB_USER=postgres
DB_PASSWORD=postgres

# 마이그레이션 마지막 단계가 권한을 정비하는 앱 롤(migrations/app_role.py)
APP_DB_USER=app_app
APP_DB_PASSWORD=app_app

JWT_SECRET=test-secret-at-least-32-bytes-long-0123456789
JWT_TTL_MINUTES=60
COOKIE_SECURE=false
# 로그인 잠금 — 연속 실패 횟수 · 잠금 시간(분)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 화면이 열리는 출처(쉼표로 여러 개) — 쓰기 요청의 Origin 이 이 밖이면 403(CSRF 방어). 배포는 화면 도메인
ALLOWED_ORIGINS=http://localhost:5174

# 워커 값(.env.example 과 같은 뜻)
WORKER_POLL_SECONDS=60
WORKER_MAX_ATTEMPTS=3

# 로컬 compose 의 s3-init 가 이 버킷을 만든다(infra/local/docker-compose.yml)
AWS_REGION=ap-northeast-2
STORAGE_BUCKET=app-files-test
S3_ENDPOINT_URL=http://127.0.0.1:8334
S3_ACCESS_KEY_ID=app
S3_SECRET_ACCESS_KEY=app-secret
