# 로컬 개발 설정 예시. 복사해서 backend/.env 로 쓴다(.env 는 커밋하지 않는다).
# 이름은 배포 환경이 넣는 환경변수와 같다(app/config.py, 결정 0002).

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8001
APP_RELOAD=true
# TRACE · DEBUG · INFO · WARNING · ERROR
LOG_LEVEL=DEBUG

# 로컬 Postgres (infra/local/docker-compose.yml). 앱은 앱 롤(app_app)로 붙는다.
# 앱 롤은 첫 마이그레이션(make db-migrate)이 만든다.
DB_HOST=127.0.0.1
DB_PORT=55434
DB_NAME=app
DB_USER=app_app
DB_PASSWORD=app_app

# 인증(결정 0006). JWT_SECRET 은 32바이트 이상. 배포에서는 비밀 저장소가 넣는다.
JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes
JWT_TTL_MINUTES=480
COOKIE_SECURE=false
# 로그인 잠금 — 연속 실패 횟수 · 잠금 시간(분)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 화면이 열리는 출처(쉼표로 여러 개) — 쓰기 요청의 Origin 이 이 밖이면 403(CSRF 방어). 배포는 화면 도메인
ALLOWED_ORIGINS=http://localhost:5174

# 스토리지(결정 0004). 로컬은 S3 호환 컨테이너(infra/local/docker-compose.yml, 계정·버킷은 infra/local/seaweedfs/).
# 배포에서는 S3_* 셋을 비우고(또는 빼고) 실행 역할로 붙는다. 로컬 컨테이너는 리전 값을 보지 않는다.
AWS_REGION=ap-northeast-2
STORAGE_BUCKET=app-files
S3_ENDPOINT_URL=http://127.0.0.1:8334
S3_ACCESS_KEY_ID=app
S3_SECRET_ACCESS_KEY=app-secret

# 워커(python -m app.worker)만 읽는다 — 보조 폴링 간격(초) · 시도 상한은 프로세스 공용.
# 동시 처리 수 · 고아 회수 기준(분)은 소비자(작업 큐)마다 WORKER_<소비자 이름>_CONCURRENCY · WORKER_<소비자 이름>_ORPHAN_MINUTES 로
# 두고 소비자를 더하는 PR 이 그 줄을 더한다.
WORKER_POLL_SECONDS=60
WORKER_MAX_ATTEMPTS=3

# 관리자 시드 명령(python -m app.domains.auth.seed_admin)만 읽는다
ADMIN_LOGIN_ID=admin
ADMIN_INITIAL_PASSWORD=change-me
