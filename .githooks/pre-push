#!/usr/bin/env bash
# main 직접 push 와 force push 를 막는다. GitHub 요금제에 따라 비공개 저장소에 서버 쪽 브랜치 보호가 적용되지 않을 수 있어,
# 같은 규칙을 각자의 PC 에서 건다(collaboration.md 「git 규칙」). `make setup` 이 core.hooksPath 로 켠다.
#
# git 은 push 하려는 ref 마다 stdin 으로 "<local ref> <local sha> <remote ref> <remote sha>" 한 줄을 넘긴다.
# 판정할 수 없는 경우(원격 커밋이 로컬에 없음)는 통과시키지 않고 이유를 알린다.
set -euo pipefail

ZERO=0000000000000000000000000000000000000000
remote_name="$1"
blocked=0

while read -r _ local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: main 으로 직접 push 할 수 없다($remote_name). 작업 브랜치에서 PR 로 머지한다." >&2
    blocked=1
    continue
  fi
  # 새 브랜치·태그 생성이거나 원격 ref 삭제면 되감기 판정 대상이 아니다.
  if [ "$remote_sha" = "$ZERO" ] || [ "$local_sha" = "$ZERO" ]; then
    continue
  fi
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "pre-push: 원격 $remote_ref 의 커밋($remote_sha)이 로컬에 없어 되감기 여부를 판정할 수 없다. git fetch 후 다시 push 한다." >&2
    blocked=1
    continue
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: $remote_ref 를 되감는 push(force push)는 할 수 없다. 공유한 브랜치는 merge 로 맞춘다." >&2
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  echo "pre-push: 급한 예외는 사람이 직접 'git push --no-verify' 로 우회하고, 이유를 PR·Issue 에 남긴다(local-setup.md 「문제 해결」)." >&2
  exit 1
fi
